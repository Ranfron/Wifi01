    <!-- Home -->
    <string name="main_subtitle">Fast file transfer between two phones over Wi-Fi Direct. No internet or mobile data needed.</string>
    <string name="send_files">Send files</string>
    <string name="receive_files">Receive files</string>
    <string name="setup_title">Before you start</string>
    <string name="check_permission_ok">Permissions granted</string>
    <string name="check_permission_missing">Permission needed to find nearby devices</string>
    <string name="check_wifi_ok">Wi-Fi is on</string>
    <string name="check_wifi_off">Wi-Fi is off. Turn it on (it does not need to be connected to a network).</string>
    <string name="check_location_ok">Location is on</string>
    <string name="check_location_off">Location is off. Android needs it to find nearby devices.</string>
    <string name="grant">Grant</string>
    <string name="tips_title">Tips for maximum speed</string>
    <string name="tips">1. On the receiving phone open “Receive files” first.\n2. On the sending phone open “Send files”, search, and tap the receiving phone. Accept the invitation on the receiving phone.\n3. Choose any number of files of any type, or share them straight from Gallery or Files with “Send with WifiP2P”.\n4. Keep both phones close (a few metres) with both screens on. Phones with Android 10+ use the fast 5 GHz band automatically.\n5. Received files are saved in Downloads/WifiP2P.</string>

