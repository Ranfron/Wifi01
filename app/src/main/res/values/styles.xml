<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ===== Shapes ===== -->
    <style name="ShapeAppearance.App.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.App.Medium" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearance.App.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <style name="ShapeAppearanceOverlay.App.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.Tile" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearanceOverlay.App.Hero" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>

    <!-- ===== Cards ===== -->
    <!-- Default card: white (dark grey in dark mode) with a hairline outline, no shadow. -->
    <style name="Widget.App.Card" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/card_bg</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">@color/card_stroke</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Card</item>
    </style>

    <!-- Soft grey-blue card without outline, for hints and tips. -->
    <style name="Widget.App.Card.Tonal" parent="Widget.App.Card">
        <item name="cardBackgroundColor">?attr/colorSurfaceContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Card tinted with the brand container colour, for the "files waiting" notice. -->
    <style name="Widget.App.Card.Brand" parent="Widget.App.Card">
        <item name="cardBackgroundColor">?attr/colorPrimaryContainer</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- Home hero panel (the gradient is drawn by the child view). -->
    <style name="Widget.App.Card.Hero" parent="Widget.App.Card">
        <item name="cardBackgroundColor">@color/hero_end</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Hero</item>
    </style>

    <!-- Big tappable tiles on the home screen. -->
    <style name="Widget.App.Card.Tile" parent="Widget.App.Card">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearanceOverlay.App.Tile</item>
    </style>
    <style name="Widget.App.Card.Tile.Primary" parent="Widget.App.Card.Tile">
        <item name="cardBackgroundColor">@color/action_bg</item>
        <item name="strokeWidth">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- ===== Buttons ===== -->
    <!-- Translucent pill button that sits on the blue hero panel. -->
    <style name="Widget.App.Button.OnHero" parent="Widget.Material3.Button.TonalButton">
        <item name="backgroundTint">@color/hero_button</item>
        <item name="android:textColor">@color/white</item>
        <item name="iconTint">@color/white</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- ===== Small text pieces ===== -->
    <!-- Version chip on the hero panel. -->
    <style name="Widget.App.Chip.Hero" parent="">
        <item name="android:background">@drawable/bg_pill_hero</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:paddingBottom">5dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelSmall</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <!-- "Connect" label on a found phone. -->
    <style name="Widget.App.Chip.Action" parent="">
        <item name="android:background">@drawable/bg_pill_primary</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">7dp</item>
        <item name="android:paddingBottom">7dp</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelLarge</item>
        <item name="android:textColor">?attr/colorOnPrimaryContainer</item>
    </style>

    <!-- Section heading above a group of cards. -->
    <style name="Widget.App.SectionTitle" parent="">
        <item name="android:textAppearance">?attr/textAppearanceTitleMedium</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

</resources>
